# Copy to .env (git-ignored) for local overrides, or set these as real
# environment variables on your host (Railway/Render). Never commit real values.
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
JWT_EXPIRATION_MS=86400000

ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=ChangeMe@123
SEED_DEMO_DATA=true

CORS_ORIGINS=http://localhost:5173

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
