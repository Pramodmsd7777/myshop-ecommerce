ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO_DATA=true

CORS_ORIGINS=http://localhost:5173

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
